{
  "name": "string-state-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint:factory-ownership": "eslint \"src/factoryOwnership/**/*.{js,ts}\" --max-warnings=0",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:factory-ownership": "vitest run --config vitest.factory-ownership.config.ts",
    "compile-scripts": "node scripts/compile-scripts.mjs",
    "compile-scripts:watch": "node --watch --watch-path=scenarios scripts/compile-scripts.mjs",
    "cloud-clusters": "node scripts/cloud-clusters.mjs",
    "trace:factory-ownership": "node scripts/trace-factory-ownership.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
